  "seed": 20261111,
  "targets": 300,
  "checks": {
    "ideal_hardware_exact": {
      "passed": true,
      "detail": "naive and calibrated errors on ideal couplers are below 1e-9"
    },
    "calibration_never_worse": {
      "passed": true,
      "detail": "calibrated error <= naive error for every target and coupler error"
    },
    "in_range_targets_exact": {
      "passed": true,
      "detail": "every target inside the analytic reachable range is realized to 1e-9"
    },
    "reachable_fraction_matches_theory": {
      "passed": true,
      "detail": "observed fraction of exactly realized targets is within 3 sigma of the analytic reachable range (|u00|^2 is uniform for Haar targets)"
    },
    "naive_error_grows_with_delta_same": {
      "passed": true,
      "detail": "mean naive error increases with coupler error (same sign)"
    },
    "naive_error_grows_with_delta_opposite": {
      "passed": true,
      "detail": "mean naive error increases with coupler error (opposite sign)"
    },
    "no_loss_exact": {
      "passed": true,
      "detail": "0 dB arm loss leaves the matrix exact"
    },
    "balanced_loss_exact": {
      "passed": true,
      "detail": "equal loss in both arms only reduces power; shape error stays below 1e-9"
    },
    "imbalanced_loss_error_grows": {
      "passed": true,
      "detail": "shape error increases with arm-loss imbalance"
    },
    "phase_noise_linear_regime": {
      "passed": true,
      "detail": "mean error / sigma is constant within 10 % for sigma <= 0.01 rad"
    },
    "dac_error_quarters_per_two_bits": {
      "passed": true,
      "detail": "each 2 extra DAC bits reduce mean error by about 4x (between 2.5x and 6x)"
    },
    "calibration_helps_combined": {
      "passed": true,
      "detail": "calibration lowers the median error in the combined scenario"
    }
  },
